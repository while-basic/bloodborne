 struct SignalImpl : public PageManager::Impl {
+    inline static u64 buffer_fault_window{};
+
     SignalImpl(Vulkan::Rasterizer* rasterizer_) : Impl() {
         rasterizer = rasterizer_;
+        const char* wide_faults = std::getenv("SHADPS4_WRITE_FAULT_WINDOW_16K");
+        buffer_fault_window = wide_faults && std::strcmp(wide_faults, "1") == 0 ? 16 * 1024 : 0;
+        const char* window_kib = std::getenv("SHADPS4_BUFFER_WRITE_WINDOW_KIB");
+        if (window_kib) {
+            if (std::strcmp(window_kib, "0") == 0) {
+                buffer_fault_window = 0;
+            } else if (std::strcmp(window_kib, "16") == 0) {
+                buffer_fault_window = 16 * 1024;
+            } else if (std::strcmp(window_kib, "64") == 0) {
+                buffer_fault_window = 64 * 1024;
+            } else if (std::strcmp(window_kib, "256") == 0) {
+                buffer_fault_window = 256 * 1024;
+            }
+        }
 
         // Should be called first.
         constexpr auto priority = std::numeric_limits<u32>::min();
@@ -437,7 +455,7 @@
         const auto is_gpu_thread =
             std::this_thread::get_id() == rasterizer->GetGpuCommandProcessorThread();
         if (Common::IsWriteError(context)) {
-            return rasterizer->InvalidateMemory(addr, size, is_gpu_thread);
