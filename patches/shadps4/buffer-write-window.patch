diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1254,12 +1254,24 @@
     return value;
 }
 
-bool Rasterizer::InvalidateMemory(VAddr addr, u64 size, bool assume_locks) {
+bool Rasterizer::InvalidateMemory(VAddr addr, u64 size, bool assume_locks, u64 buffer_fault_window) {
     if (!IsMapped(addr, size)) {
         // Not GPU mapped memory, can skip invalidation logic entirely.
         return false;
     }
-    buffer_cache.InvalidateMemory(addr, size, assume_locks);
+    VAddr buffer_addr = addr;
+    u64 buffer_size = size;
+    if (buffer_fault_window == 16 * 1024 || buffer_fault_window == 64 * 1024 ||
+        buffer_fault_window == 256 * 1024) {
+        const u64 window_size = buffer_fault_window;
+        const VAddr window_start = addr & ~(window_size - 1);
+        if (size <= window_size && addr - window_start <= window_size - size &&
+            IsMapped(window_start, window_size)) {
+            buffer_addr = window_start;
+            buffer_size = window_size;
+        }
+    }
+    buffer_cache.InvalidateMemory(buffer_addr, buffer_size, assume_locks);
     texture_cache.InvalidateMemory(addr, size);
     return true;
 }
