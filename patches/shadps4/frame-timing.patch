 namespace ImGui::Sdl {
 
+static void RecordFrameTiming(Uint64 timestamp, Uint64 frequency, float delta_time) {
+    struct FrameLog {
+        std::FILE* file{};
+        Uint64 start{};
+        unsigned pending{};
+
+        FrameLog() {
+            if (const char* path = std::getenv("SHADPS4_FRAME_LOG")) {
+                file = std::fopen(path, "wx");
+                if (file) {
+                    std::fprintf(file, "elapsed_seconds,frame_ms\n");
+                } else {
+                    SDL_Log("Cannot create frame timing log: %s", path);
+                }
+            }
+        }
+
+        ~FrameLog() {
+            if (file) {
+                std::fclose(file);
+            }
+        }
+    };
+    static FrameLog log;
+    if (!log.file) {
+        return;
+    }
+    if (!log.start) {
+        log.start = timestamp;
+    }
+    std::fprintf(log.file, "%.9f,%.6f\n", double(timestamp - log.start) / double(frequency),
+                 double(delta_time) * 1000.0);
+    if (++log.pending == 120) {
+        std::fflush(log.file);
+        log.pending = 0;
+    }
+}
+
