+#ifdef __APPLE__
+#include <fcntl.h>
+/* No memfd on macOS: an unlinked POSIX shared memory object, as the runtime makes it. */
+static int shm_fd(const char* name) {
+    char path[64];
+    snprintf(path, sizeof(path), "/%s-%d", name, (int)getpid());
+    const int fd = shm_open(path, O_RDWR | O_CREAT | O_EXCL, 0600);
+    if (fd >= 0) shm_unlink(path);
+    return fd;
+}
+#define memfd_create(name, flags) shm_fd(name)
+#endif
 
