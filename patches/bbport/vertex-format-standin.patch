@@ -793,6 +794,29 @@ vk::Format SurfaceFormat(AmdGpu::DataFormat data_format, AmdGpu::NumberFormat nu
     return result;
 }
 
+vk::Format VertexFormat(AmdGpu::DataFormat data_format, AmdGpu::NumberFormat num_format) {
+    const vk::Format result = TrySurfaceFormat(data_format, num_format);
+    if (result != vk::Format::eUndefined || data_format == AmdGpu::DataFormat::FormatInvalid) {
+        return result;
+    }
+    static std::atomic<u64> count{0};
+    const u64 n = count.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (n <= 8 || (n & (n - 1)) == 0) {
+        LOG_WARNING(Render_Vulkan,
+                    "Unknown vertex data_format={} and num_format={}, using a 32-bit stand-in "
+                    "({} so far)",
+                    static_cast<u32>(data_format), static_cast<u32>(num_format), n);
+    }
+    switch (AmdGpu::GetNumberClass(num_format)) {
+    case AmdGpu::NumberClass::Sint:
+        return vk::Format::eR32Sint;
+    case AmdGpu::NumberClass::Uint:
+        return vk::Format::eR32Uint;
+    default:
+        return vk::Format::eR32Sfloat;
+    }
+}
