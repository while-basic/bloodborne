+namespace HostImport {
+bool AddChunk(const Vulkan::Instance& instance, u64 phys, void* pointer, u64 size,
+              std::string& error) {
+    error.clear();
+    if (const char* fail_at = std::getenv("BB_GUEST_IMPORT_FAIL_AT");
+        fail_at && std::strtoull(fail_at, nullptr, 0) == phys) {
+        error = "forced by BB_GUEST_IMPORT_FAIL_AT";
+        return false;
+    }
+    {
+        std::scoped_lock lk{mutex};
+        if (chunk_count == MaxChunks) {
+            error = "too many chunks";
+            return false;
+        }
+    }
+    vk::Buffer buffer;
+    vk::DeviceMemory memory;
+    if (!Import(instance, pointer, size, buffer, memory, error)) {
+        return false;
+    }
+    std::scoped_lock lk{mutex};
+    std::size_t i = chunk_count++;
+    for (; i > 0 && chunks[i - 1]->phys > phys; --i) {
+        chunks[i] = chunks[i - 1];
+    }
+    static std::uint32_t next_index = 0;
+    chunks[i] = new Chunk{phys, size, buffer, memory, next_index++};
+    chunk_bytes += size;
+    return true;
+}
