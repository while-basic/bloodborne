+u64 ImportAlignment(const Vulkan::Instance& instance) {
+    static const u64 alignment = [&] {
+        const auto chain =
+            instance.GetPhysicalDevice()
+                .getProperties2<vk::PhysicalDeviceProperties2,
+                                vk::PhysicalDeviceExternalMemoryHostPropertiesEXT>();
+        return std::max<u64>(chain.get<vk::PhysicalDeviceExternalMemoryHostPropertiesEXT>()
+                                 .minImportedHostPointerAlignment,
+                             4096);
+    }();
+    return alignment;
+}
+
+std::uint32_t FindType(const Vulkan::Instance& instance, std::uint32_t bits,
+                       vk::MemoryPropertyFlags want) {
+    const auto props = instance.GetPhysicalDevice().getMemoryProperties();
+    for (std::uint32_t i = 0; i < props.memoryTypeCount; ++i) {
+        if ((bits & (1u << i)) && (props.memoryTypes[i].propertyFlags & want) == want) {
+            return i;
+        }
+    }
+    return ~0u;
+}
