diff --git a/tests/test_guest_memory_mac.cpp b/tests/test_guest_memory_mac.cpp
new file mode 100644
index 0000000..ff72e24
--- /dev/null
+++ b/tests/test_guest_memory_mac.cpp
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Guest memory in place on macOS: the runtime's backing view imported per chunk with
+// VK_EXT_external_memory_host, found again by physical address, and refused on request.
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <sys/mman.h>
+#include "bbport_guest_memory.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+
+int main() {
+    using namespace Vulkan;
+    Instance instance(0, false);
+    assert(instance.IsHostImportSupported());
+    assert(BbGuestMemory::Usable(instance));
+    assert(BbGuestMemory::PcModelGpu(instance));
+    constexpr std::uint64_t chunk = 1 << 20;
+    void* backing = mmap(nullptr, 2 * chunk, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    assert(backing != MAP_FAILED);
+    auto* bytes = static_cast<unsigned char*>(backing);
+    std::string error;
+    assert(BbGuestMemory::HostImport::AddChunk(instance, 0, bytes, chunk, error) && error.empty());
+    setenv("BB_GUEST_IMPORT_FAIL_AT", "0x100000", 1);
+    assert(!BbGuestMemory::HostImport::AddChunk(instance, chunk, bytes + chunk, chunk, error));
+    assert(error.find("BB_GUEST_IMPORT_FAIL_AT") != std::string::npos);
+    unsetenv("BB_GUEST_IMPORT_FAIL_AT");
+    assert(BbGuestMemory::Find(0) && BbGuestMemory::Find(chunk - 1) && !BbGuestMemory::Find(chunk));
+    assert(BbGuestMemory::HostImport::AddChunk(instance, chunk, bytes + chunk, chunk, error));
+    const BbGuestMemory::Chunk* second = BbGuestMemory::Find(chunk);
+    assert(second && second->phys == chunk && second->size == chunk && second->memory && second->buffer);
+    assert(BbGuestMemory::Find(0)->index == 0 && second->index == 1);
+    // Unaligned size: refused, not imported.
+    assert(!BbGuestMemory::HostImport::AddChunk(instance, 2 * chunk, bytes, chunk + 1, error));
+    assert(error.find("aligned") != std::string::npos);
+    std::puts("guest-memory-test: OK");
+}
