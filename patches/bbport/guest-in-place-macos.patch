+/// [pointer, pointer + size) as a Vulkan buffer over the memory itself; `buffer` and `memory`
+/// stay null on failure, with `error` set.
+bool Import(const Vulkan::Instance& instance, void* pointer, u64 size, vk::Buffer& buffer,
+            vk::DeviceMemory& memory, std::string& error) {
+    buffer = nullptr;
+    memory = nullptr;
+    const vk::Device device = instance.GetDevice();
+    const u64 alignment = ImportAlignment(instance);
+    if (reinterpret_cast<std::uintptr_t>(pointer) % alignment != 0 || size == 0 ||
+        size % alignment != 0) {
+        error = "pointer or size not aligned to " + std::to_string(alignment);
+        return false;
+    }
+    const vk::ExternalMemoryBufferCreateInfo external{.handleTypes = HandleType};
+    const auto [buffer_result, created] = device.createBuffer({
+        .pNext = &external,
+        .size = size,
+        .usage = vk::BufferUsageFlagBits::eTransferSrc | vk::BufferUsageFlagBits::eTransferDst |
+                 vk::BufferUsageFlagBits::eStorageBuffer | vk::BufferUsageFlagBits::eUniformBuffer |
+                 vk::BufferUsageFlagBits::eVertexBuffer | vk::BufferUsageFlagBits::eIndexBuffer |
+                 vk::BufferUsageFlagBits::eIndirectBuffer,
+        .sharingMode = vk::SharingMode::eExclusive,
+    });
+    if (buffer_result != vk::Result::eSuccess) {
+        error = "buffer creation: " + vk::to_string(buffer_result);
+        return false;
+    }
+    const auto requirements = device.getBufferMemoryRequirements(created);
+    const auto [props_result, props] = device.getMemoryHostPointerPropertiesEXT(HandleType, pointer);
+    const std::uint32_t type =
+        props_result == vk::Result::eSuccess
+            ? FindType(instance, requirements.memoryTypeBits & props.memoryTypeBits,
+                       vk::MemoryPropertyFlagBits::eHostVisible)
+            : ~0u;
+    if (type == ~0u || requirements.size > size) {
+        device.destroyBuffer(created);
+        error = type == ~0u ? "no host-visible memory type takes the pointer (" +
+                                  vk::to_string(props_result) + ")"
+                            : "the buffer needs " + std::to_string(requirements.size) + " bytes";
+        return false;
+    }
+    const vk::ImportMemoryHostPointerInfoEXT import{.handleType = HandleType,
+                                                    .pHostPointer = pointer};
+    const auto [memory_result, allocated] = device.allocateMemory(
+        {.pNext = &import, .allocationSize = size, .memoryTypeIndex = type});
+    if (memory_result != vk::Result::eSuccess) {
+        device.destroyBuffer(created);
+        error = "import: " + vk::to_string(memory_result);
+        return false;
+    }
+    if (const auto result = device.bindBufferMemory(created, allocated, 0);
+        result != vk::Result::eSuccess) {
+        device.freeMemory(allocated);
+        device.destroyBuffer(created);
+        error = "binding: " + vk::to_string(result);
+        return false;
+    }
+    buffer = created;
+    memory = allocated;
+    return true;
 }
