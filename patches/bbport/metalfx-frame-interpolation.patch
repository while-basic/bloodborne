+void Presenter::Present(Frame* frame, bool is_reusing_frame, bool is_game_frame) {
+    // Free the frame for reuse
+    const auto free_frame = [&] {
+        if (!is_reusing_frame) {
+            last_submit_frame = frame;
+            std::scoped_lock fl{free_mutex};
+            free_queue.push(frame);
+            free_cv.notify_one();
+        }
+    };
+
+    // bbport: nothing to present to while the window is minimised (a 0x0 surface, issue #31).
+    if (window.GetWidth() == 0 || window.GetHeight() == 0) {
+        free_frame();
+        return;
+    }
+    // Recreate the swapchain if the window was resized (or was minimised at the last try).
+    if (window.GetWidth() != swapchain.GetWidth() || window.GetHeight() != swapchain.GetHeight() ||
+        !swapchain.IsPresentable()) {
+        swapchain.Recreate(window.GetWidth(), window.GetHeight());
+        if (!swapchain.IsPresentable()) {
+            free_frame();
+            return;
+        }
+    }
+
+    // bbport: MetalFX frame interpolation: the frame between the previous one and this one goes
+    // first, the real one half a frame interval later (every frame arrives that much later).
+    if (frame->has_interpolated) {
+        const auto shown = std::chrono::steady_clock::now();
+        if (!PresentImage(frame->interpolated, frame, frame->interpolated_done)) {
+            free_frame();
+            return;
+        }
+        std::this_thread::sleep_until(
+            shown + std::chrono::nanoseconds(present_interval_ns.load(std::memory_order_relaxed) / 2));
+        // Its submission is done before the swapchain's semaphores serve the real frame.
+        const auto waited = instance.GetDevice().waitForFences(frame->interpolated_done, false,
+                                                               std::numeric_limits<u64>::max());
+        ASSERT_MSG(waited == vk::Result::eSuccess,
+                   "Unexpected error waiting for the interpolated frame: {}", vk::to_string(waited));
+    }
+    if (!PresentImage(frame->image, frame, frame->present_done)) {
+        free_frame();
+        return;
+    }
+    if (is_game_frame && !is_reusing_frame) {
+        // The real frames' interval, for the interpolator's pacing and delta time.
+        const auto now = std::chrono::steady_clock::now();
+        if (last_real_present != std::chrono::steady_clock::time_point{}) {
+            const s64 delta = std::clamp<s64>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(now - last_real_present).count(),
+                1'000'000, 100'000'000);
+            const s64 average = s64(present_interval_ns.load(std::memory_order_relaxed));
+            present_interval_ns.store(u64(average + (delta - average) / 8), std::memory_order_relaxed);
+        }
+        last_real_present = now;
+    }
     free_frame();
     if (!is_reusing_frame && is_game_frame) {
         DebugState.IncFlipFrameNum();
     }
 }
 
