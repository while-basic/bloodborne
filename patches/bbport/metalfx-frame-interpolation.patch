+                  sourceBytesPerRow:width * bytes
+                sourceBytesPerImage:width * height * bytes
+                         sourceSize:MTLSizeMake(width, height, 1)
+                          toTexture:target
+                   destinationSlice:0
+                   destinationLevel:0
+                  destinationOrigin:zero];
+        };
+        upload(m.color_buffer, m.color[m.current], ow, oh, 8);
+        upload(m.depth_buffer, m.depth, w, h, 4);
+        upload(m.motion_buffer, m.motion, w, h, 4);
+        [uploads endEncoding];
+
+        // The same decision as the Vulkan side (MetalFxUpscaler::Interpolate): no previous frame,
+        // or a reset: nothing comes out this time.
+        const bool produce = m.have_previous && !frame.reset;
+        if (frame.reset) {
+            m.reset_pending = true;
+        }
+        if (produce) {
+            if (@available(macOS 26.0, *)) {
+                id<MTLFXFrameInterpolator> fi = m.interpolator;
+                fi.colorTexture = m.color[m.current];
+                fi.prevColorTexture = m.color[m.current ^ 1];
+                fi.depthTexture = m.depth;
+                fi.motionTexture = m.motion;
+                fi.outputTexture = m.output;
+                fi.uiTexture = nil;
+                fi.deltaTime = frame.delta_time;
+                fi.nearPlane = frame.near_plane;
+                fi.farPlane = frame.far_plane;
+                fi.fieldOfView = frame.fov_y;
+                fi.aspectRatio = frame.aspect;
+                fi.jitterOffsetX = frame.jitter_x;
+                fi.jitterOffsetY = frame.jitter_y;
+                fi.motionVectorScaleX = frame.motion_scale_x;
+                fi.motionVectorScaleY = frame.motion_scale_y;
+                fi.depthReversed = frame.depth_reversed;
+                fi.shouldResetHistory = m.reset_pending;
+                [fi encodeToCommandBuffer:cmd];
+            }
+            m.reset_pending = false;
+            id<MTLBlitCommandEncoder> downloads = [cmd blitCommandEncoder];
+            [downloads copyFromTexture:m.output
+                             sourceSlice:0
+                             sourceLevel:0
+                            sourceOrigin:zero
+                              sourceSize:MTLSizeMake(ow, oh, 1)
+                                toBuffer:m.output_buffer
+                       destinationOffset:0
+                  destinationBytesPerRow:ow * 8
+                destinationBytesPerImage:ow * oh * 8];
+            [downloads endEncoding];
+        }
+        m.current ^= 1;
+        m.have_previous = true;
+        if (async) {
+            const uint64_t value = frame.signal_value;
+            [cmd encodeSignalEvent:signal_event value:value];
+            std::shared_ptr<Scaler::Impl::Errors> errors = m.errors;
+            [cmd addCompletedHandler:^(id<MTLCommandBuffer> done) {
+              if (done.status != MTLCommandBufferStatusCompleted) {
+                  if (signal_event.signaledValue < value) {
+                      signal_event.signaledValue = value;
+                  }
+                  std::scoped_lock lock{errors->mutex};
+                  errors->text = "interpolation command buffer failed: " + Describe(done.error);
+              }
+            }];
+            m.last = cmd;
+            [cmd commit];
+            return produce;
+        }
+        [cmd commit];
+        [cmd waitUntilCompleted];
+        if (cmd.status != MTLCommandBufferStatusCompleted) {
+            error = "interpolation command buffer failed: " + Describe(cmd.error);
+            return false;
+        }
+        return produce;
+    }
+}
+
+bool Interpolator::TakeError(std::string& error) {
+    std::scoped_lock lock{impl->errors->mutex};
+    if (impl->errors->text.empty()) {
+        return false;
+    }
+    error = std::move(impl->errors->text);
+    impl->errors->text.clear();
+    return true;
+}
