+bool MetalFxUpscaler::EnsureInterpolator(const Interpolation& in) {
+    if (interpolator && in.width == interp_width && in.height == interp_height) {
+        return true;
+    }
+    scheduler.Finish();
+    interpolator.reset();
+    for (auto& s : interp_staging) {
+        DestroyStaging(s);
+    }
+    interp_color = VideoCore::UniqueImage{};
+    interp_width = in.width;
+    interp_height = in.height;
+    interp_have_previous = false;
+    const vk::DeviceSize pixels = vk::DeviceSize(in.width) * in.height;
+    for (auto& s : interp_staging) {
+        if (!CreateStaging(s, pixels * 8)) {
+            interp_off = true;
+            std::printf("Upscaler: MetalFX frame interpolation off (cannot allocate exportable "
+                        "staging buffers)\n");
+            return false;
+        }
+    }
+    interp_color = VideoCore::UniqueImage{instance.GetDevice(), instance.GetAllocator()};
+    interp_color.Create({
+        .imageType = vk::ImageType::e2D,
+        .format = vk::Format::eR16G16B16A16Sfloat,
+        .extent = {in.width, in.height, 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = vk::SampleCountFlagBits::e1,
+        .tiling = vk::ImageTiling::eOptimal,
+        .usage = vk::ImageUsageFlagBits::eTransferSrc | vk::ImageUsageFlagBits::eTransferDst,
+    });
+    std::string error;
+    interpolator = BbMetalFx::Interpolator::Create(
+        {.in_width = width, .in_height = height, .out_width = in.width, .out_height = in.height},
+        {interp_staging[0].heap, staging[1].heap, staging[2].heap, interp_staging[1].heap}, error);
+    if (!interpolator) {
+        interp_off = true;
+        std::printf("Upscaler: MetalFX frame interpolation off (%s)\n", error.c_str());
+        return false;
+    }
+    std::printf("Upscaler: MetalFX frame interpolation on, %ux%u (depth and motion %ux%u)\n",
+                in.width, in.height, width, height);
+    return true;
+}
+
+bool MetalFxUpscaler::Interpolate(const Interpolation& in) {
+    if (!supported || fatal || interp_off || !scaler || !ran_this_frame) {
+        return false;
+    }
+    ran_this_frame = false;
+    if (!EnsureInterpolator(in)) {
+        return false;
+    }
+    const auto fail = [&](const std::string& reason) {
+        interp_off = true;
+        std::printf("Upscaler: MetalFX frame interpolation off (%s)\n", reason.c_str());
+        return false;
+    };
+    {
+        std::string error;
+        if (async && interpolator->TakeError(error)) {
+            return fail(error);
+        }
+    }
+    // The same decision as the Metal side (Interpolator::Encode).
+    const bool produce = interp_have_previous && !in.reset;
+    interp_have_previous = true;
+
+    auto cmd = scheduler.CommandBuffer();
+    constexpr auto rw = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite;
+    const vk::MemoryBarrier2 before_copy{
+        .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eTransfer,
+        .dstAccessMask = vk::AccessFlagBits2::eTransferRead | vk::AccessFlagBits2::eTransferWrite,
+    };
+    cmd.pipelineBarrier2({.memoryBarrierCount = 1, .pMemoryBarriers = &before_copy});
+    const vk::ImageSubresourceRange color_range{vk::ImageAspectFlagBits::eColor, 0, 1, 0, 1};
+    const auto image_barrier = [&](vk::Image image, vk::ImageLayout old_layout,
+                                   vk::PipelineStageFlags2 src, vk::AccessFlags2 src_access,
+                                   vk::PipelineStageFlags2 dst, vk::AccessFlags2 dst_access) {
+        const vk::ImageMemoryBarrier2 barrier{
+            .srcStageMask = src,
+            .srcAccessMask = src_access,
+            .dstStageMask = dst,
+            .dstAccessMask = dst_access,
+            .oldLayout = old_layout,
+            .newLayout = vk::ImageLayout::eGeneral,
+            .image = image,
+            .subresourceRange = color_range,
+        };
+        cmd.pipelineBarrier2({.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &barrier});
+    };
+    // The presented frame (any format) as RGBA16F, then into the exported buffer.
+    image_barrier(vk::Image(interp_color), vk::ImageLayout::eUndefined,
+                  vk::PipelineStageFlagBits2::eAllCommands, rw,
+                  vk::PipelineStageFlagBits2::eTransfer, vk::AccessFlagBits2::eTransferWrite);
+    const std::array<vk::Offset3D, 2> whole{vk::Offset3D{0, 0, 0},
+                                            vk::Offset3D{s32(in.width), s32(in.height), 1}};
+    const vk::ImageBlit blit{
+        .srcSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1},
+        .srcOffsets = whole,
+        .dstSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1},
+        .dstOffsets = whole,
+    };
+    cmd.blitImage(in.color, vk::ImageLayout::eGeneral, vk::Image(interp_color),
+                  vk::ImageLayout::eGeneral, blit, vk::Filter::eNearest);
+    image_barrier(vk::Image(interp_color), vk::ImageLayout::eGeneral,
+                  vk::PipelineStageFlagBits2::eTransfer, vk::AccessFlagBits2::eTransferWrite,
+                  vk::PipelineStageFlagBits2::eTransfer, vk::AccessFlagBits2::eTransferRead);
+    const vk::BufferImageCopy region{
+        .imageSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1},
+        .imageExtent = {in.width, in.height, 1},
+    };
+    cmd.copyImageToBuffer(vk::Image(interp_color), vk::ImageLayout::eGeneral,
+                          interp_staging[0].buffer, region);
+    const vk::MemoryBarrier2 to_metal{
+        .srcStageMask = vk::PipelineStageFlagBits2::eTransfer,
+        .srcAccessMask = vk::AccessFlagBits2::eTransferWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eHost,
+        .dstAccessMask = vk::AccessFlagBits2::eHostRead,
+    };
+    cmd.pipelineBarrier2({.memoryBarrierCount = 1, .pMemoryBarriers = &to_metal});
+
+    static const bool invert_jitter = EnvOn("BB_METALFX_INVERT_JITTER");
+    static const bool invert_motion = EnvOn("BB_METALFX_INVERT_MOTION");
+    static const bool depth_reversed = EnvOn("BB_METALFX_DEPTH_REVERSED");
+    const float jitter_sign = invert_jitter ? -1.0f : 1.0f;
+    const float motion_sign = invert_motion ? -1.0f : 1.0f;
+    BbMetalFx::InterpolatorFrame metal{.delta_time = in.delta_time,
+                                       .near_plane = in.near_plane,
+                                       .far_plane = in.far_plane,
+                                       .fov_y = in.fov_y,
+                                       .aspect = in.aspect,
+                                       .jitter_x = jitter_sign * in.jitter[0],
+                                       .jitter_y = jitter_sign * in.jitter[1],
+                                       .motion_scale_x = motion_sign,
+                                       .motion_scale_y = motion_sign,
+                                       .reset = in.reset,
+                                       .depth_reversed = depth_reversed};
+    const u64 copies_tick = scheduler.CurrentTick();
+    if (mode == Mode::Sync) {
+        scheduler.Finish();
+        std::string error;
+        interpolator->Encode(metal, error);
+        if (!error.empty()) {
+            return fail(error);
+        }
+    } else if (mode == Mode::Events) {
+        scheduler.Flush();
+        metal.wait_event = work_event;
+        metal.wait_value = copies_tick;
+        metal.signal_event = done_event;
+        metal.signal_value = done_value + 1;
+        std::string error;
+        interpolator->Encode(metal, error);
+        if (!error.empty()) {
+            return fail(error);
+        }
+    } else {
+        scheduler.Flush();
+    }
+
+    cmd = scheduler.CommandBuffer();
+    if (produce) {
+        image_barrier(in.output, vk::ImageLayout::eUndefined,
+                      vk::PipelineStageFlagBits2::eAllCommands, rw,
+                      vk::PipelineStageFlagBits2::eTransfer, vk::AccessFlagBits2::eTransferWrite);
+        cmd.copyBufferToImage(interp_staging[1].buffer, in.output, vk::ImageLayout::eGeneral,
+                              region);
+        image_barrier(in.output, vk::ImageLayout::eGeneral, vk::PipelineStageFlagBits2::eTransfer,
+                      vk::AccessFlagBits2::eTransferWrite,
+                      vk::PipelineStageFlagBits2::eAllCommands, rw);
+    }
+    if (mode == Mode::Events) {
+        ++done_value;
+        SubmitInfo info{};
+        info.AddWait(done_semaphore, done_value);
+        scheduler.Flush(info);
+    } else if (mode == Mode::SubmitThread) {
+        SubmitInfo info{};
+        info.before_submit.push_back(
+            [this, metal, copies_tick, work = scheduler.GetWorkSemaphore()] {
+                work->Wait(copies_tick);
+                std::string error;
+                interpolator->Encode(metal, error);
+                if (!error.empty()) {
+                    std::scoped_lock lock{deferred_mutex};
+                    deferred_error = error;
+                }
+            });
+        scheduler.Flush(info);
+    }
+    return produce;
+}
